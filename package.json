{
  "name": "one-piece-tcg-collection",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build -w @one-piece-tcg/shared",
    "dev": "concurrently -k -n shared,api,web -c yellow,cyan,magenta \"npm run dev -w @one-piece-tcg/shared\" \"npm run dev -w @one-piece-tcg/api\" \"npm run dev -w @one-piece-tcg/web\"",
    "build": "npm run build -w @one-piece-tcg/shared && npm run build -w @one-piece-tcg/api && npm run build -w @one-piece-tcg/web",
    "prestart": "npm run build",
    "start": "concurrently -k -n api,web -c cyan,magenta \"npm run start -w @one-piece-tcg/api\" \"npm run preview -w @one-piece-tcg/web\"",
    "pretypecheck": "npm run build -w @one-piece-tcg/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "pretest": "npm run build -w @one-piece-tcg/shared",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "npm run seed -w @one-piece-tcg/api",
    "db:local": "npm run db:local -w @one-piece-tcg/api",
    "images:check": "npm run images:check -w @one-piece-tcg/api",
    "images:cleanup": "npm run images:cleanup -w @one-piece-tcg/api"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}
